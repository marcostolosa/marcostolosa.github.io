---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { disclosures, hallOfFame, imports, links, profile, tools } from '../data/profile';
import { localize, tr, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (en: string, pt: string) => (lang === 'en' ? en : pt);

const writeups = (await getCollection('writeups', (w) => !w.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const hex = (base: number, i: number, step: number) => (base + i * step).toString(16).toUpperCase().padStart(8, '0');
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const mail = `mailto:${profile.email}?subject=${encodeURIComponent(L('Engagement inquiry', 'Proposta de engajamento'))}`;
const regs = [
  { r: 'RIP', v: 'CVE-2025-10230 · CVSS 10.0', hot: true },
  { r: 'RAX', v: '6', c: L('U.S. Gov Hall of Fame', 'Hall of Fame do Governo dos EUA') },
  { r: 'RBX', v: '15', c: L('valid vulns', 'vulns válidas') },
  { r: 'RCX', v: L('93.75%', '93,75%'), c: L('accuracy', 'precisão') },
  { r: 'RDX', v: 'Bugcrowd · H1 · YWH · Intigriti' },
  { r: 'RSI', v: 'OWASP', c: L('member since 2021', 'membro desde 2021') },
];
---
<Base
  lang={lang}
  title={L('Marcos Tolosa (Tr0p): red team, exploit dev, reverse engineering', 'Marcos Tolosa (Tr0p): red team, exploit dev, engenharia reversa')}
  description={L(
    'Red teamer, exploit developer and reverse engineer. CVE-2025-10230 (CVSS 10.0, Samba). 6× U.S. Government Hall of Fame. Available for pentest and red team engagements.',
    'Red teamer, exploit developer e engenheiro reverso. CVE-2025-10230 (CVSS 10.0, Samba). 6× Hall of Fame do Governo dos EUA. Disponível para pentest e red team.',
  )}
  debugger
>
  <div class="cpu">
    <section class="pane main" aria-label="CPU">
      <div class="ph"><span>CPU · tr0p.bin</span><span class="a">00401000</span></div>

      <header class="hero" id="whoami" data-step="whoami">
        <p class="c">; breakpoint 1 · whoami() · {tr(profile.base, lang)}</p>
        <h1>{profile.name} <span class="k">{profile.handle}</span></h1>
        <p class="lede">{tr(profile.lede, lang)}</p>
        <div class="actions">
          <a class="btn" href={mail}>{L('Open an engagement', 'Abrir um engajamento')}</a>
          <a class="ghost" href={localize('/writeups/', lang)}>{L('or read the writeups', 'ou leia os writeups')}</a>
        </div>
      </header>

      <section id="disclosures" data-step="disclosures" aria-labelledby="h-disc">
        <div class="fh">
          <h2 id="h-disc">disclosures</h2>
          <span class="c">; {disclosures.length} {L('public records, each one an xref', 'registros públicos, cada um é um xref')}</span>
        </div>
        <ol class="lst" translate="no">
          {disclosures.map((d, i) => (
            <li class={i === 0 ? 'ip' : i === 1 ? 'nx' : undefined}>
              <span class="mk" aria-hidden="true">
                {i === 0 && <svg width="10" height="10" viewBox="0 0 10 10"><path d="M2 1l7 4-7 4z" fill="currentColor" /></svg>}
                {i === 1 && <svg width="10" height="10" viewBox="0 0 10 10"><path d="M3 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" /></svg>}
              </span>
              <span class="a">{hex(0x401140, i, 0x28)}</span>
              <span class="body">
                <a href={d.href}>{d.id}</a>{' '}
                <span class="k" data-sym={d.sym}>{d.sym}</span>{' '}
                <span class="s">"{d.cls}"</span>
                {d.note && <span class="c"> ; {tr(d.note, lang)}</span>}
              </span>
              <span class={d.crit ? 'sev crit' : 'sev'}><span class="visually-hidden">{L('severity', 'severidade')} </span>{d.sev}</span>
            </li>
          ))}
        </ol>
      </section>
    </section>

    <aside class="pane side" id="registers" aria-label={L('Registers and stack', 'Registradores e pilha')}>
      <div class="ph"><span>{L('Registers', 'Registradores')}</span><span>x64</span></div>
      <dl class="regs" translate="no">
        {regs.map((x) => (
          <div>
            <dt>{x.r}</dt>
            <dd class={x.hot ? 'hot' : undefined}>{x.v}{x.c && <span class="c"> ; {x.c}</span>}</dd>
          </div>
        ))}
      </dl>
      <p class="flags"><span>ZF <b>0</b></span><span>OF <b>1</b></span><span class="c">; {L('authorized', 'autorizado')} = 1</span></p>

      <div class="ph"><span>{L('Stack · tools', 'Pilha · ferramentas')}</span><span>RSP</span></div>
      <ol class="stack" id="tools" translate="no">
        {tools.map((t, i) => (
          <li>
            <span class="a">{hex(0x19ff40, i, 8)}</span>
            <span>
              <a class="tn" href={t.href}>{t.name}</a>
              <span class="td">{tr(t.desc, lang)}</span>
              <span class="tt a">{t.tags}{t.repo && <> · <a href={t.repo}>{L('source', 'código')}</a></>}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="imports" translate="no"><span class="c">; imports</span> {imports.join(' · ')}</p>
    </aside>
  </div>

  <section class="band" id="hall_of_fame" data-step="hall_of_fame" aria-labelledby="h-hof">
    <div class="fh">
      <h2 id="h-hof">hall_of_fame</h2>
      <span class="c">; {tr(hallOfFame.summary, lang)}</span>
    </div>
    <ol class="lst hof" translate="no">
      {hallOfFame.agencies.map((a, i) => (
        <li>
          <span class="mk"></span>
          <span class="a">{hex(0x401380, i, 5)}</span>
          <span class="body"><span class="k">push</span> <span class="s" data-sym={a === 'NCUA' ? 'us_gov' : undefined}>"{a}"</span></span>
        </li>
      ))}
      <li>
        <span class="mk"></span>
        <span class="a">{hex(0x401380, hallOfFame.agencies.length, 5)}</span>
        <span class="body"><span class="k">call</span> <a href={hallOfFame.record}>bugcrowd.com/h/Tr0p</a> <span class="c">; {L('full record · plus', 'registro completo · mais')} {tr(hallOfFame.also, lang)}</span></span>
      </li>
    </ol>
  </section>

  <section class="band" id="writeups" data-step="writeups" aria-labelledby="h-wr">
    <div class="fh">
      <h2 id="h-wr">writeups</h2>
      <span class="c">; {L('root cause, step by step', 'causa raiz, passo a passo')}</span>
    </div>
    {writeups.length > 0 ? (
      <ol class="lst" translate="no">
        {writeups.slice(0, 5).map((w, i) => (
          <li>
            <span class="mk"></span>
            <span class="a">{hex(0x401520, i, 0x10)}</span>
            <span class="body"><a href={`/writeups/${w.id}/`} hreflang={w.data.lang}>{w.data.title}</a> <span class="c">; {fmt(w.data.date)}</span></span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty"><span class="c">; {L('nothing published here yet.', 'nada publicado aqui ainda.')}</span> {L('Until then, the advisories in', 'Até lá, os advisories em')} <a href="#disclosures">disclosures()</a> {L('are the primary sources.', 'são as fontes primárias.')}</p>
    )}
  </section>

  <section class="log" aria-label="Log">
    <p><span class="a">[+]</span> {L('breakpoint hit at whoami(), visitor attached', 'breakpoint em whoami(), visitante anexado')}</p>
    <p><span class="a">[*]</span> {L('next on', 'próximo no')} <span class="k">step</span> (F8 / n): <span class="k" id="next-hint" translate="no">disclosures()</span></p>
    <p><span class="a">[*]</span> <span class="k">run</span> (F9) {L('continues to', 'segue até')} connect()</p>
  </section>

  <section class="connect" id="connect" data-step="connect" aria-labelledby="h-con">
    <p class="c">; sub_401600 connect()</p>
    <h2 id="h-con">{L('Got something in scope?', 'Tem algo no escopo?')}</h2>
    <p class="lede">{L('Pentests, red team engagements and security research. Send the target and the rules of engagement.', 'Pentest, red team e pesquisa de segurança. Mande o alvo e as regras de engajamento.')}</p>
    <div class="actions">
      <a class="btn" id="mail" href={mail}>{profile.email}</a>
    </div>
    <ul class="links">
      {links.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
    </ul>
  </section>

</Base>

<style>
  .cpu { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(340px, 1fr); gap: 1px; background: var(--line); border-bottom: 1px solid var(--line); }
  .pane { background: var(--bg); min-width: 0; }
  .ph { display: flex; justify-content: space-between; padding: 8px var(--pad); border-bottom: 1px solid var(--line); font-size: 12px; color: var(--addr); background: var(--gutter); }
  .side .ph { padding: 8px 22px; }

  .hero { padding: clamp(36px, 7vh, 72px) var(--pad) 36px; }
  h1 { font: 900 clamp(2.9rem, 6.4vw, 5.6rem)/0.93 var(--disp); letter-spacing: -0.035em; color: var(--fg-hi); margin: 14px 0 18px; text-wrap: balance; }
  h1 .k { display: block; }
  .lede { font: 500 clamp(1.1rem, 1.5vw, 1.25rem)/1.5 var(--disp); color: var(--fg); max-width: 46ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; margin-top: 30px; }
  .btn {
    display: inline-block; background: var(--kw); color: var(--bg); text-decoration: none;
    font: 700 15px/1 var(--disp); padding: 15px 20px; border-radius: 4px;
    box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.8);
    transition: transform 180ms var(--ease), background-color 180ms var(--ease);
  }
  .btn:hover { background: #f1c77a; color: var(--bg); transform: translateY(-1px); }
  .ghost { font: 500 15px/1 var(--disp); }

  .fh { display: flex; gap: 6px 16px; align-items: baseline; flex-wrap: wrap; padding: 26px var(--pad) 12px; border-top: 1px solid var(--line); }
  h2 { font: 800 1.55rem/1.2 var(--disp); color: var(--fg-hi); letter-spacing: -0.02em; }
  h2:focus { outline: none; }
  [data-ip] > .fh h2 { color: var(--kw); }
  .fh .c { font-size: 13px; }

  .lst { list-style: none; padding: 0 0 22px; }
  .lst li {
    display: grid; grid-template-columns: 18px 92px minmax(0, 1fr) auto; gap: 12px; align-items: baseline;
    padding: 6px var(--pad) 6px calc(var(--pad) - 30px); transition: background-color 180ms var(--ease);
  }
  .lst li:hover { background: var(--hl); }
  .lst li.ip { background: var(--hl); }
  .lst .mk { color: var(--kw); display: flex; align-items: center; }
  .lst li.nx { box-shadow: inset 2px 0 0 var(--kw); }
  .lst li.nx .mk { color: var(--addr); }
  .sev {
    font: 700 12.5px/1 var(--mono); color: var(--bg); background: var(--num); padding: 4px 7px; border-radius: 3px;
    min-width: 48px; text-align: center; font-variant-numeric: tabular-nums;
  }
  .sev.crit { background: var(--crit); }

  .regs { padding: 12px 22px 4px; font-size: 13.5px; }
  .regs div { display: grid; grid-template-columns: 50px 1fr; padding: 6px 0; border-bottom: 1px dashed var(--line); }
  .regs dt { color: var(--addr); }
  .regs dd { color: var(--fg-hi); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .regs dd.hot { color: var(--crit); }
  .flags { display: flex; gap: 14px; padding: 10px 22px 18px; color: var(--dim); font-size: 12.5px; }
  .flags b { color: var(--kw); font-weight: 500; }
  .stack { list-style: none; padding: 10px 22px 6px; font-size: 13px; }
  .stack li { display: grid; grid-template-columns: 84px 1fr; gap: 10px; padding: 8px 0; border-bottom: 1px dashed var(--line); }
  .stack li:last-child { border-bottom: 0; }
  .tn { font: 800 1.02rem/1.3 var(--disp); color: var(--fg-hi); text-decoration: none; }
  .tn:hover { color: var(--kw); }
  .td { display: block; color: var(--dim); line-height: 1.55; margin-top: 2px; }
  .tt { display: block; font-size: 12px; margin-top: 2px; }
  .imports { padding: 10px 22px 22px; font-size: 12.5px; color: var(--dim); line-height: 1.7; }

  .band { border-bottom: 1px solid var(--line); }
  .band .fh { border-top: 0; padding-top: 34px; }
  .empty { padding: 0 var(--pad) 28px; color: var(--dim); }

  .connect { padding: 64px var(--pad) 56px; border-bottom: 1px solid var(--line); }
  .connect h2 { font: 900 clamp(2.2rem, 5vw, 3.8rem)/1 var(--disp); letter-spacing: -0.03em; margin: 12px 0 16px; }
  .links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 28px; }
  .log { padding: 18px var(--pad) 22px; font-size: 13px; color: var(--dim); background: var(--gutter); border-bottom: 1px solid var(--line); }
  .log p { padding: 2px 0; }

  @media (max-width: 960px) {
    .cpu { grid-template-columns: 1fr; }
    .side .ph, .regs, .flags, .stack, .imports { padding-left: var(--pad); padding-right: var(--pad); }
  }
  @media (max-width: 640px) {
    .lst li { grid-template-columns: 14px minmax(0, 1fr) auto; gap: 8px; padding: 9px var(--pad) 9px 6px; }
    .lst .a { display: none; }
    .lst li .body { overflow-wrap: anywhere; }
    .stack li { grid-template-columns: 1fr; gap: 2px; }
    .stack li > .a { font-size: 11.5px; }
  }
</style>
