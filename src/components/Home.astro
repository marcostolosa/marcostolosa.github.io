---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { buildGraph, typeName, type NodeType } from '../data/graph';
import { disclosures, hallOfFame, imports, links, platforms, profile, tools } from '../data/profile';
import { localize, tr, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (en: string, pt: string) => (lang === 'en' ? en : pt);

const writeups = (await getCollection('writeups', (w) => !w.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const mail = `mailto:${profile.email}?subject=${encodeURIComponent(L('Engagement inquiry', 'Proposta de engajamento'))}`;
const targetName: Record<string, string> = { samba: 'Samba', wegia: 'WeGIA', us_gov: 'NCUA', be_gov: L('Belgian Government', 'Governo da Bélgica') };

// --- the graph: same data as the sections below, laid out at build time
const mine = writeups.filter((w) => w.data.lang === lang);
const graph = buildGraph(lang, (mine.length ? mine : writeups).map((w) => ({ id: w.id, title: w.data.title, summary: w.data.summary })));
const start = graph.nodes.findIndex((n) => n.id === 'vuln:CVE-2025-10230');
const first = graph.nodes[start];
const neighbours = (i: number) => graph.edges.filter(([a, b]) => a === i || b === i).map(([a, b]) => (a === i ? b : a));
const types = Object.keys(typeName) as NodeType[];
const strings = {
  open: L('Open source', 'Abrir fonte'),
  contact: L('Get in touch', 'Entrar em contato'),
  types: Object.fromEntries(types.map((t) => [t, tr(typeName[t], lang)])),
};
// static projection for the no-WebGL fallback (same pitch the scene starts with)
const proj = graph.nodes.map((n) => {
  const [c, s] = [Math.cos(-0.5), Math.sin(-0.5)];
  const x = n.p[0] * c + n.p[2] * s;
  const z = -n.p[0] * s + n.p[2] * c;
  return { x, y: -(n.p[1] * Math.cos(0.2) - z * Math.sin(0.2)) };
});
const payload = JSON.stringify({ graph, start, strings }).replace(/</g, '\\u003c');
---
<Base
  lang={lang}
  title={L('Marcos Tolosa (Tr0p): red team, pentest, bug bounty', 'Marcos Tolosa (Tr0p): red team, pentest, bug bounty')}
  description={L(
    'Red teamer, pentester and bug bounty hunter. CVE-2025-10230 (CVSS 10.0, Samba). 6× U.S. Government Hall of Fame. Available for pentest and red team engagements.',
    'Red teamer, pentester e bug hunter. CVE-2025-10230 (CVSS 10.0, Samba). 6× Hall of Fame do Governo dos EUA. Disponível para pentest e red team.',
  )}
>
  <section class="hero" id="whoami" data-tint="writeup" aria-labelledby="h-me">
    <div class="stage" id="stage" aria-hidden="true">
      <svg class="fallback" viewBox="-1.15 -1.15 2.3 2.3">
        {graph.edges.map(([a, b]) => <line x1={proj[a].x} y1={proj[a].y} x2={proj[b].x} y2={proj[b].y} />)}
        {graph.nodes.map((n, i) => <circle cx={proj[i].x} cy={proj[i].y} r={n.size * 0.05 + 0.008} data-t={n.type} />)}
      </svg>
      <canvas></canvas>
      <div class="labels"></div>
    </div>

    <div class="intro">
      <p class="cmd boot" aria-hidden="true"><b>tr0p@mindsecurity</b>:~$ <i class="typed">whoami</i><span class="cur"></span></p>
      <h1 id="h-me" data-text={profile.name}>{profile.name}</h1>
      <p class="aka">{L('Known as Tr0p. Red teamer, pentester and bug bounty hunter.', 'Conhecido como Tr0p. Red teamer, pentester e bug hunter.')}</p>
      <p class="lede">{L(
        'You don’t have to take my word for it. This graph is my public record: pick a node and open its source.',
        'Não precisa acreditar em mim. Este grafo é o meu registro público: escolha um nó e abra a fonte.',
      )}</p>
      <div class="actions">
        <a class="btn" href={mail}>{L('Open an engagement', 'Abrir um engajamento')}</a>
        <a class="ghost" href={localize('/writeups/', lang)}>{L('or read the writeups', 'ou leia os writeups')}</a>
      </div>
    </div>

    <aside class="insp" aria-label={L('Selected node', 'Nó selecionado')}>
      <p class="wbar" aria-hidden="true"><span></span><span></span><span></span>osint://tr0p/node</p>
      <div class="card" id="insp" aria-live="polite" data-t={first.type}>
        <p class="type"><span class="dot" aria-hidden="true"></span><span id="insp-type">{strings.types[first.type]}</span></p>
        <p class="title" id="insp-title" translate="no">{first.label}</p>
        <p class="desc" id="insp-desc">{first.desc}</p>
        <p class="rel">
          <span>{L('Linked to', 'Ligado a')}</span>
          <span id="insp-links">
            {neighbours(start).map((j) => <button type="button" data-i={j} data-t={graph.nodes[j].type}>{graph.nodes[j].label}</button>)}
          </span>
        </p>
        <a class="src" id="insp-src" href={first.href}><span id="insp-open">{strings.open}</span><span class="id" id="insp-host">{first.src}</span></a>
      </div>
      <div class="walk">
        <button type="button" id="prev" aria-label={L('Previous node', 'Nó anterior')}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <span class="id" id="insp-count">{start + 1} / {graph.nodes.length}</span>
        <button type="button" id="next" aria-label={L('Next node', 'Próximo nó')}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <span class="hint">{L('Drag to rotate, click a node', 'Arraste para girar, clique em um nó')}</span>
      </div>
    </aside>

    <ul class="legend" aria-label={L('Node types', 'Tipos de nó')}>
      {types.map((t) => <li data-t={t}><span class="dot" aria-hidden="true"></span>{strings.types[t]}</li>)}
    </ul>
    <script type="application/json" id="graph-data" set:html={payload} />
  </section>

  <section class="sec" id="disclosures" data-focus="vuln" data-tint="vuln" aria-labelledby="h-disc">
    <header class="sh">
      <p class="cmd" aria-hidden="true"><b>tr0p@mindsecurity</b>:~$ <i>cat findings.log</i></p>
      <h2 id="h-disc">{L('Disclosed vulnerabilities', 'Vulnerabilidades divulgadas')}</h2>
      <p>{L('Six public records. Each one links to the advisory, the patch or the programme that confirmed it.', 'Seis registros públicos. Cada um leva ao advisory, ao patch ou ao programa que confirmou.')}</p>
    </header>
    <ol class="lst">
      {disclosures.map((d, i) => (
        <li class={i === 0 ? 'top' : undefined}>
          <span class={d.crit ? 'sev crit' : 'sev'} translate="no"><span class="visually-hidden">{L('severity', 'severidade')} </span>{d.sev}</span>
          <span class="what">
            <a href={d.href} translate="no">{d.id}</a>
            <span class="tgt" translate="no">{targetName[d.sym]}</span>
          </span>
          <span class="cls">{d.cls}{d.note && <span class="note">{tr(d.note, lang)}</span>}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec" id="hall_of_fame" data-focus="target" data-tint="target" aria-labelledby="h-hof">
    <header class="sh">
      <p class="cmd" aria-hidden="true"><b>tr0p@mindsecurity</b>:~$ <i>cat hall_of_fame.txt</i></p>
      <h2 id="h-hof">Hall of Fame</h2>
      <p>{tr(hallOfFame.summary, lang)}. {L('The full record is on', 'O registro completo está em')} <a href={hallOfFame.record}>bugcrowd.com/h/Tr0p</a>.</p>
    </header>
    <ul class="hof" translate="no">
      {hallOfFame.agencies.map((a) => <li>{a}</li>)}
      <li>{tr(hallOfFame.also, lang)}</li>
    </ul>
    <p class="plat">{L('Active on', 'Ativo em')} {platforms.join(', ')}. {L('OWASP member since 2021.', 'Membro da OWASP desde 2021.')}</p>
  </section>

  <section class="sec" id="tools" data-focus="tool" data-tint="tool" aria-labelledby="h-tools">
    <header class="sh">
      <p class="cmd" aria-hidden="true"><b>tr0p@mindsecurity</b>:~$ <i>ls -la tools/</i></p>
      <h2 id="h-tools">{L('Tools I built', 'Ferramentas que construí')}</h2>
      <p>{L('What an engagement teaches me usually ends up as code.', 'O que um engajamento me ensina costuma virar código.')}</p>
    </header>
    <ul class="tools">
      {tools.map((t) => (
        <li>
          <a class="tn" href={t.i18n ? localize(t.href, lang) : t.href} translate="no">{t.name}</a>
          <span class="td">{tr(t.desc, lang)}</span>
          <span class="tt"><span class="id" translate="no">{t.tags}</span>{t.repo && <a href={t.repo} aria-label={`${t.name}: ${L('source code', 'código-fonte')}`}>{L('source', 'código')}</a>}</span>
        </li>
      ))}
    </ul>
    <p class="arsenal" translate="no"><span>{L('Day-to-day arsenal', 'Arsenal do dia a dia')}</span> {imports.join(', ')}</p>
  </section>

  <section class="sec" id="writeups" data-focus="writeup" data-tint="writeup" aria-labelledby="h-wr">
    <header class="sh">
      <p class="cmd" aria-hidden="true"><b>tr0p@mindsecurity</b>:~$ <i>ls writeups/</i></p>
      <h2 id="h-wr">Writeups</h2>
      <p>{L('Root cause first, then the exploit, step by step.', 'Primeiro a causa raiz, depois o exploit, passo a passo.')}</p>
    </header>
    {writeups.length > 0 ? (
      <ol class="wr">
        {writeups.slice(0, 5).map((w) => (
          <li>
            <span class="id" translate="no">{fmt(w.data.date)}</span>
            <a href={`/writeups/${w.id}/`} hreflang={w.data.lang} lang={w.data.lang === 'en' ? 'en-US' : 'pt-BR'}>{w.data.title}</a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">{L('Nothing published yet. Until then, the advisories under', 'Nada publicado ainda. Até lá, os advisories em')} <a href="#disclosures">{L('disclosed vulnerabilities', 'vulnerabilidades divulgadas')}</a> {L('are the primary sources.', 'são as fontes primárias.')}</p>
    )}
  </section>

  <section class="connect" id="connect" data-focus="account" data-tint="vuln" aria-labelledby="h-con">
    <p class="cmd" aria-hidden="true"><b>tr0p@mindsecurity</b>:~$ <i>./contact --scope yours</i></p>
    <h2 id="h-con">{L('Got something in scope?', 'Tem algo no escopo?')}</h2>
    <p class="lede">{L('Pentests, red team engagements and security research. Send the target and the rules of engagement.', 'Pentest, red team e pesquisa de segurança. Mande o alvo e as regras de engajamento.')}</p>
    <div class="actions">
      <a class="btn" id="mail" href={mail}>{profile.email}</a>
    </div>
    <ul class="links">
      {links.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
    </ul>
  </section>
</Base>

<script>
  import type { Graph } from '../data/graph';

  const hero = document.getElementById('whoami')!;

  // The name decrypts once on load: glyphs settle left to right into the real text.
  const h1 = hero.querySelector('h1')!;
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const real = h1.textContent!, pool = '01<>/\\[]{}#$%&*+=-_';
    const t0 = performance.now() + 550;
    const tick = (now: number) => {
      const k = Math.max(0, (now - t0) / 900);
      h1.textContent = [...real].map((ch, i) => (ch === ' ' || i < k * real.length ? ch : pool[(Math.random() * pool.length) | 0])).join('');
      if (k < 1) requestAnimationFrame(tick); else h1.textContent = real;
    };
    requestAnimationFrame(tick);
  }
  const data = JSON.parse(document.getElementById('graph-data')!.textContent!) as {
    graph: Graph; start: number; strings: { open: string; contact: string; types: Record<string, string> };
  };
  const { nodes, edges } = data.graph;
  const adj: number[][] = nodes.map(() => []);
  edges.forEach(([a, b]) => { adj[a].push(b); adj[b].push(a); });

  const $ = (id: string) => document.getElementById(id)!;
  const card = $('insp'), linksEl = $('insp-links'), src = $('insp-src') as HTMLAnchorElement;
  let current = data.start;
  let scene: { select(i: number, turn?: boolean): void; focus(type: string | null): void } | undefined;

  function show(i: number) {
    current = i;
    const n = nodes[i];
    card.dataset.t = n.type;
    $('insp-type').textContent = data.strings.types[n.type];
    $('insp-title').textContent = n.label;
    $('insp-desc').textContent = n.desc;
    linksEl.replaceChildren(
      ...adj[i].map((j) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.i = String(j);
        b.dataset.t = nodes[j].type;
        b.textContent = nodes[j].label;
        return b;
      }),
    );
    src.hidden = !n.href;
    if (n.href) {
      src.href = n.href;
      $('insp-open').textContent = n.href.startsWith('#') ? data.strings.contact : data.strings.open;
      $('insp-host').textContent = n.src ?? '';
    }
    $('insp-count').textContent = `${i + 1} / ${nodes.length}`;
    scene?.select(i);
  }

  linksEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('button[data-i]');
    if (!b) return;
    show(Number(b.dataset.i));
    // the clicked button is replaced; keep keyboard users inside the card
    linksEl.querySelector<HTMLElement>('button')?.focus();
  });
  $('prev').addEventListener('click', () => show((current - 1 + nodes.length) % nodes.length));
  $('next').addEventListener('click', () => show((current + 1) % nodes.length));

  // three.js is the heavy part: load it after the page is interactive, and keep the SVG if WebGL is unavailable.
  const css = getComputedStyle(document.documentElement);
  const colors = Object.fromEntries(Object.keys(data.strings.types).map((t) => [t, css.getPropertyValue(`--t-${t}`).trim()]));
  import('../scripts/osint-graph')
    .then(({ mount }) => {
      scene = mount({
        stage: $('stage'),
        input: hero,
        canvas: hero.querySelector('canvas')!,
        labels: hero.querySelector<HTMLElement>('.labels')!,
        graph: data.graph,
        colors,
        selected: current,
        onPick: show,
      });
      hero.classList.add('gl');
      // Scroll focus: each section names the kind of node it is about; the scene flies there and steps back.
      const zones = [...document.querySelectorAll<HTMLElement>('[data-focus]')];
      let queued = false;
      const sync = () => {
        queued = false;
        const mid = innerHeight * 0.5;
        const z = zones.find((el) => { const r = el.getBoundingClientRect(); return r.top <= mid && r.bottom > mid; });
        scene!.focus(z ? z.dataset.focus! : null);
      };
      addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(sync); } }, { passive: true });
      addEventListener('resize', sync);
      sync();
    })
    .catch(() => hero.classList.add('no-gl'));
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative; display: flex; flex-direction: column; justify-content: center;
    min-height: calc(100svh - var(--bar)); padding: 56px var(--pad) 150px;
  }
  /* Wide screens: the scene is fixed behind the whole page and follows the scroll. Its canvas composites additively. */
  .stage {
    position: fixed; inset: var(--bar) 0 0 0; z-index: -1; user-select: none;
    transition: opacity 900ms var(--ease), filter 900ms var(--ease);
  }
  /* out of focus on purpose: behind the sections the scene is atmosphere, the text is the subject */
  .stage:global([data-mode='ambient']) { opacity: 0.3; filter: blur(5px); }
  .stage::after { transition: opacity 900ms var(--ease); }
  .stage:global([data-mode='ambient'])::after { opacity: 0; }
  .stage::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: none;
  }
  canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 900ms var(--ease); }
  .gl canvas { opacity: 1; }
  .fallback { position: absolute; right: 0; top: 46%; width: min(66%, 105vh); transform: translateY(-50%); overflow: visible; transition: opacity 500ms var(--ease); }
  .gl .fallback { opacity: 0; }
  .fallback line { stroke: var(--line); stroke-width: 0.004; }
  .fallback circle { fill: var(--c); }

  :global([data-t='person']) { --c: var(--t-person); }
  :global([data-t='vuln']) { --c: var(--t-vuln); }
  :global([data-t='target']) { --c: var(--t-target); }
  :global([data-t='account']) { --c: var(--t-account); }
  :global([data-t='tool']) { --c: var(--t-tool); }
  :global([data-t='writeup']) { --c: var(--t-writeup); }

  .labels { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .labels :global(span) {
    position: absolute; left: 0; top: 0; white-space: nowrap; opacity: 0; color: var(--c);
    font: 600 0.72rem/1 var(--mono);
    text-shadow: 0 0 4px var(--bg), 0 0 10px var(--bg), 0 0 18px var(--bg);
    transition: opacity 260ms var(--ease); will-change: transform;
  }
  .labels :global(span.on) { font-weight: 700; font-size: 0.84rem; color: var(--fg-hi); }

  .intro { max-width: 37rem; pointer-events: none; }
  .intro a { pointer-events: auto; }
  h1 {
    position: relative; margin-top: 14px;
    font: 700 clamp(2.7rem, 6vw, 5rem)/0.98 var(--mono); letter-spacing: -0.045em;
    color: var(--fg-hi); text-shadow: 0 0 28px rgba(53, 242, 154, 0.45);
  }
  /* glitch: two offset copies of the name flash in slices every few seconds */
  h1::before, h1::after { content: attr(data-text); position: absolute; inset: 0; opacity: 0; pointer-events: none; text-shadow: none; }
  h1::before { color: var(--t-vuln); animation: glitch-a 6.5s steps(1) 2.4s infinite; }
  h1::after { color: var(--t-account); animation: glitch-b 6.5s steps(1) 2.4s infinite; }
  @keyframes glitch-a {
    0%, 4%, 100% { opacity: 0; }
    1% { opacity: 0.85; transform: translate(-5px, 1px); clip-path: inset(12% 0 58% 0); }
    2% { opacity: 0.85; transform: translate(4px, -1px); clip-path: inset(64% 0 8% 0); }
    3% { opacity: 0.85; transform: translate(-3px, 0); clip-path: inset(38% 0 36% 0); }
  }
  @keyframes glitch-b {
    0%, 4%, 100% { opacity: 0; }
    1% { opacity: 0.85; transform: translate(5px, -1px); clip-path: inset(52% 0 20% 0); }
    2% { opacity: 0.85; transform: translate(-4px, 1px); clip-path: inset(6% 0 72% 0); }
    3% { opacity: 0.85; transform: translate(3px, 0); clip-path: inset(74% 0 4% 0); }
  }
  .boot .typed { display: inline-block; overflow: hidden; vertical-align: bottom; white-space: nowrap; width: 6ch; animation: typing 500ms steps(6) 100ms backwards; }
  @keyframes typing { from { width: 0; } }
  @media (prefers-reduced-motion: reduce) { h1::before, h1::after, .boot .typed { animation: none; } }
  .aka { margin-top: 20px; font: 600 clamp(1rem, 1.35vw, 1.15rem)/1.4 var(--mono); color: var(--acc); max-width: 34ch; }
  .lede { margin-top: 12px; font-size: 0.97rem; line-height: 1.6; color: var(--dim); max-width: 48ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; margin-top: 30px; }
  .ghost { font-weight: 500; }

  .insp { position: absolute; right: var(--pad); bottom: 34px; width: min(410px, 38vw); }
  .wbar {
    display: flex; align-items: center; gap: 6px; padding: 8px 12px; font-size: 0.72rem; color: var(--addr);
    border: 1px solid var(--line); border-bottom: 0; border-radius: 4px 4px 0 0; background: var(--gutter);
  }
  .wbar span { width: 8px; height: 8px; border-radius: 50%; background: var(--line); }
  .wbar span:first-child { background: var(--t-vuln); }
  .wbar span:nth-child(2) { background: var(--t-target); }
  .wbar span:nth-child(3) { background: var(--acc); margin-right: 8px; }
  .card {
    padding: 16px 18px 14px; border-radius: 0 0 4px 4px; border: 1px solid color-mix(in srgb, var(--c) 40%, var(--line));
    background: color-mix(in srgb, var(--gutter) 90%, transparent);
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.9), 0 0 40px -18px var(--c);
    transition: border-color 300ms var(--ease);
  }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--c); box-shadow: 0 0 10px var(--c); }
  .type { display: flex; align-items: center; gap: 8px; font-size: 0.76rem; font-weight: 600; color: var(--c); text-transform: lowercase; }
  .type::before { content: 'type:'; color: var(--addr); font-weight: 400; }
  .title { margin-top: 6px; font: 700 1.3rem/1.15 var(--mono); letter-spacing: -0.03em; color: var(--fg-hi); overflow-wrap: anywhere; }
  .desc { margin-top: 8px; font-size: 0.85rem; line-height: 1.55; color: var(--fg); }
  .rel { display: flex; flex-wrap: wrap; gap: 6px 8px; align-items: center; margin-top: 12px; font-size: 0.8rem; color: var(--addr); }
  #insp-links { display: contents; }
  .rel :global(button) {
    all: unset; cursor: pointer; display: inline-flex; align-items: center; min-height: 26px; padding: 0 8px; border-radius: 2px;
    font: 600 0.76rem/1 var(--mono); color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
    transition: background-color 180ms var(--ease);
  }
  .rel :global(button:hover) { background: color-mix(in srgb, var(--c) 16%, transparent); }
  .rel :global(button:focus-visible) { outline: 2px solid var(--acc); outline-offset: 2px; }
  .src {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin-top: 14px; padding-top: 12px;
    border-top: 1px solid var(--line); font-weight: 700; font-size: 0.94rem;
  }
  .src .id { color: var(--addr); font-weight: 400; overflow-wrap: anywhere; }
  .src[hidden] { display: none; }
  .walk { display: flex; align-items: center; gap: 10px; margin-top: 10px; color: var(--addr); }
  .walk button {
    all: unset; cursor: pointer; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 2px;
