---
// A tool's landing page, written as its README: pitch and live demo on top, the file below.
import Base from '../layouts/Base.astro';
import type { ToolPage } from '../data/toolpages';

interface Props { tool: ToolPage }
const { tool: t } = Astro.props;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** Prose with `inline code`. */
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');
/** A shell line: program in white, flags as keywords, quoted arguments as strings. */
const sh = (cmd: string) =>
  '<span class="s">$</span> ' +
  cmd.split(' ').map((tok, i) => {
    const e = esc(tok);
    if (i === 0) return `<b>${e}</b>`;
    if (/^--?[a-z]/i.test(tok)) return `<span class="k">${e}</span>`;
    if (/^["']/.test(tok)) return `<span class="s">${e}</span>`;
    return e;
  }).join(' ');

const demo = t.demo.lines
  .map((l) => ('cmd' in l ? sh(l.cmd) : 'out' in l ? l.out : 'note' in l ? `<span class="c"># ${esc(l.note)}</span>` : ''))
  .concat('<span class="s">$</span> <span class="cur"></span>')
  .join('\n');

const toc = [
  ['features', 'Features'],
  ['usage', 'Usage'],
  ['pipeline', t.pipeline.title],
  ['numbers', 'Numbers'],
  ['install', 'Install'],
  ['links', 'Links'],
];
---
<Base title={t.title} description={t.description} alternates={{ en: `/${t.slug}/`, 'pt-br': '/pt-br/#tools' }}>
  <div class="tp" data-tint={t.tint} style={`--c: var(--t-${t.tint})`}>
    <header class="hero">
      <div class="pitch">
        <p class="cmd" aria-hidden="true"><b>tr0p@mindsecurity</b>:~/{t.slug}$ <i>cat README.md</i></p>
        <h1 translate="no"><span class="hash" aria-hidden="true"># </span>{t.name}</h1>
        <p class="tag">{t.tagline}</p>
        <p class="lede" set:html={md(t.lede)} />
        <ul class="badges" aria-label="Project facts">
          {t.badges.map(([k, v]) => <li><span>{k}</span><b>{v}</b></li>)}
        </ul>
        <p class="cta">
          <a class="btn" href="#install">Install</a>
          <a href={t.repo} rel="noopener">Source on GitHub</a>
        </p>
      </div>
      <figure class="term">
        <figcaption translate="no"><span aria-hidden="true">● </span>{t.demo.title}</figcaption>
        <pre tabindex="0" translate="no"><code set:html={demo} /></pre>
      </figure>
    </header>

    <div class="doc">
      <nav class="toc" aria-label="On this page">
        <p aria-hidden="true">README.md</p>
        <ul>
          {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>

      <article class="file">
        <section id="features" aria-labelledby="h-features">
          <h2 id="h-features"><span class="hash" aria-hidden="true">## </span>Features</h2>
          <p class="intro">{t.features.intro}</p>
          <dl class="feat">
            {t.features.items.map((f) => (
              <div>
                <dt>{f.name}</dt>
                <dd set:html={md(f.desc)} />
              </div>
            ))}
          </dl>
        </section>

        <section id="usage" aria-labelledby="h-usage">
          <h2 id="h-usage"><span class="hash" aria-hidden="true">## </span>Usage</h2>
          <p class="intro">{t.usage.intro}</p>
          <div class="modes">
            {t.usage.modes.map((m) => (
              <div class="mode">
                <h3>{m.name} <span class="chip">{m.tag}</span></h3>
                <p>{m.desc}</p>
                <pre tabindex="0" translate="no"><code set:html={m.cmds.map(sh).join('\n')} /></pre>
              </div>
            ))}
          </div>
        </section>

        <section id="pipeline" aria-labelledby="h-pipeline">
          <h2 id="h-pipeline"><span class="hash" aria-hidden="true">## </span>{t.pipeline.title}</h2>
          <p class="intro">{t.pipeline.intro}</p>
          <ol class="pipe">
            {t.pipeline.steps.map((s, i) => (
              <li>
                <span class="n" aria-hidden="true">[{i + 1}/{t.pipeline.steps.length}]</span>
                <span><b>{s.name}</b> {s.desc}</span>
              </li>
            ))}
          </ol>
        </section>

        <section id="numbers" aria-labelledby="h-numbers">
          <h2 id="h-numbers"><span class="hash" aria-hidden="true">## </span>Numbers</h2>
          <table>
            <thead><tr><th scope="col">Metric</th><th scope="col">Value</th></tr></thead>
            <tbody>
              {t.numbers.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
            </tbody>
          </table>
        </section>

        <section id="install" aria-labelledby="h-install">
          <h2 id="h-install"><span class="hash" aria-hidden="true">## </span>Install</h2>
          <p class="intro" set:html={md(t.install.intro)} />
          <div class="copy">
            <pre tabindex="0" translate="no"><code set:html={sh(t.install.cmd)} /></pre>
            <button type="button" id="copy" data-cmd={t.install.cmd} aria-live="polite">Copy</button>
          </div>
          <ul class="req">
            {t.install.notes.map((n) => <li set:html={md(n)} />)}
          </ul>
        </section>

        <section id="links" aria-labelledby="h-links">
          <h2 id="h-links"><span class="hash" aria-hidden="true">## </span>Links</h2>
          <p class="closing">{t.closing}</p>
          <ul class="links">
            {t.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
            <li><a href={t.docs} rel="noopener">Docs</a></li>
            <li><a href="/#tools">More tools by Tr0p</a></li>
          </ul>
        </section>
      </article>
    </div>
  </div>
</Base>

<script>
  const b = document.getElementById('copy');
  b?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.cmd!); b.textContent = 'Copied'; }
    catch { b.textContent = 'Select and copy'; }
    setTimeout(() => { b.textContent = 'Copy'; }, 1800);
  });
</script>

<style>
  .tp { max-width: 1280px; margin-inline: auto; padding: clamp(36px, 8vh, 88px) var(--pad) clamp(64px, 10vh, 112px); }
  .hash { color: var(--c); }

  /* pitch */
  .hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  h1 {
    margin: 14px 0 18px; color: var(--fg-hi); font: 700 clamp(2.7rem, 8vw, 5.6rem)/0.95 var(--mono); letter-spacing: -0.06em;
    text-shadow: 0 0 34px color-mix(in srgb, var(--c) 55%, transparent);
  }
  .tag { max-width: 24ch; color: var(--fg-hi); font: 600 clamp(1.15rem, 2.2vw, 1.5rem)/1.3 var(--mono); letter-spacing: -0.02em; }
  .lede { max-width: 58ch; margin-top: 14px; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; padding: 0; list-style: none; font: 500 0.76rem/1 var(--mono); }
  .badges li { display: inline-flex; border: 1px solid var(--line); }
  .badges span { padding: 6px 8px; background: var(--panel-2); color: var(--dim); }
  .badges b { padding: 6px 8px; background: color-mix(in srgb, var(--c) 14%, var(--gutter)); color: var(--c); font-weight: 600; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 30px; }

  .tp :global(:not(pre) > code) {
    padding: 1px 5px; border-radius: 2px; background: rgba(255, 182, 39, 0.09); color: var(--t-target); font: inherit; font-size: 0.94em;
  }

  /* terminal blocks */
  pre { overflow-x: auto; padding: 16px 18px; color: var(--dim); font: 400 0.82rem/1.85 var(--mono); }
  pre :global(b) { color: var(--fg-hi); font-weight: 500; }
  pre :global(.bar) { color: var(--c); }
  .term {
    min-width: 0; border: 1px solid color-mix(in srgb, var(--c) 45%, var(--line));
    background: color-mix(in srgb, var(--gutter) 90%, transparent); backdrop-filter: blur(10px);
    box-shadow: 0 0 60px -18px color-mix(in srgb, var(--c) 70%, transparent);
  }
  .term figcaption { padding: 9px 14px; border-bottom: 1px solid var(--line); color: var(--addr); font-size: 0.78rem; }
  .term figcaption span { color: var(--c); }

  /* the file */
  .doc { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); margin-top: clamp(56px, 11vh, 120px); }
  .toc { position: sticky; top: calc(var(--bar) + 24px); align-self: start; font-size: 0.86rem; }
  .toc p { margin-bottom: 8px; color: var(--addr); }
  .toc ul { padding: 0; list-style: none; }
  .toc li::before { content: '├─ '; color: var(--line); }
  .toc li:last-child::before { content: '└─ '; }
  .toc a { display: inline-block; padding: 4px 0; color: var(--dim); text-decoration: none; }
  .toc a:hover { color: var(--c); }

  .file {
    max-width: 900px; border: 1px solid var(--line);
    background: color-mix(in srgb, var(--gutter) 86%, transparent); backdrop-filter: blur(10px);
  }
  .file section { padding: clamp(22px, 4vw, 44px); }
  .file section + section { border-top: 1px dashed var(--line); }
  h2 { color: var(--fg-hi); font: 700 1.5rem/1.2 var(--mono); letter-spacing: -0.03em; }
  .intro { max-width: 64ch; margin-top: 10px; color: var(--dim); }

  .feat { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 40px; margin-top: 26px; }
  .feat dt { color: var(--fg-hi); font-weight: 600; }
  .feat dt::before { content: '[+] '; color: var(--c); }
  .feat dd { margin-top: 4px; color: var(--dim); font-size: 0.93rem; }

  .modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 26px; }
  .mode { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--fg-hi); font: 600 1.02rem/1.3 var(--mono); }
  .chip { padding: 3px 7px; border: 1px solid var(--line); color: var(--addr); font-size: 0.72rem; font-weight: 500; }
  .mode p { color: var(--dim); font-size: 0.93rem; }
  .mode pre, .copy pre { border: 1px solid var(--line); background: var(--gutter); }
  .mode pre { margin-top: auto; }

  .pipe { display: grid; margin-top: 22px; padding: 0; list-style: none; }
  .pipe li { display: grid; grid-template-columns: 4.6ch minmax(0, 1fr); gap: 14px; padding: 10px 0; color: var(--dim); }
  .pipe li + li { border-top: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
  .pipe .n { color: var(--c); font-variant-numeric: tabular-nums; }
  .pipe b { margin-right: 6px; color: var(--fg-hi); font-weight: 600; }

  table { width: 100%; max-width: 620px; margin-top: 20px; border-collapse: collapse; }
  th, td { padding: 9px 14px 9px 0; border-bottom: 1px solid var(--line); text-align: left; font-weight: 400; }
  thead th { color: var(--addr); font-size: 0.82rem; }
  tbody th { color: var(--fg); }
  td { color: var(--c); font-weight: 700; white-space: nowrap; }

  .copy { display: flex; margin-top: 20px; }
  .copy pre { flex: 1; min-width: 0; border-right: 0; white-space: pre; }
  .copy button {
    flex: none; min-width: 84px; padding: 0 16px; border: 1px solid var(--acc); background: var(--panel-2); color: var(--acc);
    font: 600 0.82rem/1 var(--mono); cursor: pointer; transition: background-color 180ms var(--ease), color 180ms var(--ease);
  }
  .copy button:hover { background: var(--acc); color: var(--gutter); }
  .req { display: grid; gap: 6px; margin-top: 18px; padding: 0; list-style: none; color: var(--dim); font-size: 0.93rem; }
  .req li::before { content: '- '; color: var(--c); }

  .closing { max-width: 58ch; margin-top: 10px; color: var(--fg); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 26px; margin-top: 18px; padding: 0; list-style: none; }

  @media (max-width: 900px) {
    .hero, .doc, .modes { grid-template-columns: minmax(0, 1fr); }
    .toc { position: static; }
    .toc ul { display: flex; flex-wrap: wrap; gap: 2px 20px; }
    .toc li::before, .toc li:last-child::before { content: './'; color: var(--addr); }
    .toc a { padding: 8px 0; }
  }
  @media (max-width: 640px) {
    .feat { grid-template-columns: minmax(0, 1fr); }
    .copy { flex-direction: column; }
    .copy pre { border-right: 1px solid var(--line); border-bottom: 0; }
    .copy button { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) { .copy button { transition: none; } }
</style>
