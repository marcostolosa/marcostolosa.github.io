---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { langLabel, localize, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (en: string, pt: string) => (lang === 'en' ? en : pt);

const writeups = (await getCollection('writeups', (w) => !w.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base
  lang={lang}
  title={L('Writeups — Marcos Tolosa (Tr0p)', 'Writeups — Marcos Tolosa (Tr0p)')}
  description={L(
    'Technical writeups on vulnerability research, exploit development and reverse engineering by Marcos Tolosa (Tr0p).',
    'Writeups técnicos de pesquisa de vulnerabilidades, desenvolvimento de exploits e engenharia reversa por Marcos Tolosa (Tr0p).',
  )}
>
  <header class="head">
    <p class="cmd" aria-hidden="true"><b>tr0p@mindsecurity</b>:~$ <i>ls -lt writeups/</i></p>
    <h1>Writeups</h1>
    <p class="lede">{L(
      'Root cause first, then the exploit, then how to find the next one. Step by step, nothing skipped.',
      'Primeiro a causa raiz, depois o exploit, depois como achar o próximo. Passo a passo, sem pular nada.',
    )}</p>
  </header>

  {writeups.length > 0 ? (
    <ol class="list">
      {writeups.map((w) => (
        <li>
          <a href={`/writeups/${w.id}/`} hreflang={w.data.lang} lang={w.data.lang === 'en' ? 'en-US' : 'pt-BR'}>
            <span class="meta a" translate="no">{fmt(w.data.date)} · {langLabel[w.data.lang]}{w.data.cve && <> · {w.data.cve}</>}{w.data.severity && <> · {w.data.severity}</>}</span>
            <span class="t">{w.data.title}</span>
            <span class="sum">{w.data.summary}</span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <div class="empty">
      <p>{L('Nothing published here yet. Until the first writeup lands, the coordinated advisories are the primary sources: start at the', 'Nada publicado aqui ainda. Até o primeiro writeup sair, os advisories coordenados são as fontes primárias: comece pelas')} <a href={localize('/#disclosures', lang)}>{L('disclosed vulnerabilities', 'vulnerabilidades divulgadas')}</a>.</p>
    </div>
  )}
</Base>

<style>
  .head { padding: clamp(56px, 10vh, 110px) var(--pad) 44px; max-width: 1440px; margin-inline: auto; }
  h1 { font: 700 clamp(2.6rem, 6vw, 4.6rem)/0.98 var(--mono); color: var(--fg-hi); letter-spacing: -0.06em; text-shadow: 0 0 28px rgba(53, 242, 154, 0.4); }
  h1::before { content: '# '; color: var(--acc); }
  .lede { margin-top: 20px; font-size: 1rem; line-height: 1.5; color: var(--dim); max-width: 46ch; }
  .list { list-style: none; padding: 0 var(--pad) 80px; max-width: 1440px; margin-inline: auto; }
  .list li { border-top: 1px solid var(--line); }
  .list li:last-child { border-bottom: 1px solid var(--line); }
  .list a {
    display: grid; gap: 6px; padding: 28px 12px; margin-inline: -12px;
    text-decoration: none; color: var(--fg); transition: background-color 180ms var(--ease);
  }
  .list a:hover { background: var(--hl); }
  .meta { font: 500 0.78rem/1.4 var(--mono); color: var(--t-writeup); }
  .t { font: 700 clamp(1.2rem, 2vw, 1.5rem)/1.25 var(--mono); color: var(--fg-hi); letter-spacing: -0.04em; text-wrap: balance; }
  .sum { color: var(--dim); max-width: 68ch; }
  .empty { padding: 0 var(--pad) 80px; color: var(--dim); max-width: 80ch; }
</style>
