---
import '../styles/global.css';
import { profile } from '../data/profile';
import { defaultLang, htmlLang, langLabel, langName, localize, locales, tr, ui, unlocalize, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Per-locale URL of this page. Defaults to the same path in each locale; pass when a translation does not exist. */
  alternates?: Partial<Record<Lang, string>>;
  /** Long-form reading pages keep the animated background at roughly half strength. */
  quiet?: boolean;
}
const { title, description, lang = defaultLang, alternates, quiet = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = unlocalize(Astro.url.pathname);
const alt = Object.fromEntries(locales.map((l) => [l, alternates?.[l] ?? localize(base, l)])) as Record<Lang, string>;
const t = (k: keyof typeof ui) => tr(ui[k], lang);
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#050a08" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta property="og:locale" content={htmlLang[lang].replace('-', '_')} />
    {!alternates && locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(alt[l], Astro.site)} />)}
    {!alternates && <link rel="alternate" hreflang="x-default" href={new URL(alt.en, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // First visit to the English home from a Portuguese browser: offer PT-BR once. An explicit choice always wins.
      try {
        var pref = localStorage.getItem('lang');
        if (!pref && location.pathname === '/' && /^pt\b/i.test((navigator.languages && navigator.languages[0]) || navigator.language || '')) {
          localStorage.setItem('lang', 'pt-br');
          location.replace('/pt-br/' + location.hash);
        }
      } catch (e) {}
      // Remember an explicit language choice. Delegated from <head> so it works before any module script loads.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('.lang a[data-lang]');
        if (a) try { localStorage.setItem('lang', a.getAttribute('data-lang')); } catch (err) {}
      }, true);
    </script>
  </head>
  <body data-bg={quiet ? 'quiet' : undefined}>
    <canvas id="backdrop" aria-hidden="true"></canvas>
    <a class="skip" href="#main">{t('skip')}</a>

    <header class="tb">
      <a class="brand" href={localize('/', lang)} translate="no">
        <span class="at">root@</span>{profile.handle.toLowerCase()}<span class="at">:~#</span><span class="cur" aria-hidden="true"></span>
        <span class="visually-hidden">{t('home')}</span>
      </a>
      <nav class="sec" aria-label={t('nav')}>
        <a class="opt" href={localize('/#disclosures', lang)}>{t('findings')}</a>
        <a class="opt" href={localize('/#tools', lang)}>{t('tools')}</a>
        <a href={localize('/writeups/', lang)} aria-current={base.startsWith('/writeups') ? 'page' : undefined}>{t('writeups')}</a>
        <a class="opt" href={localize('/#connect', lang)}>{t('contact')}</a>
      </nav>
      <nav class="lang" aria-label={t('language')}>
        {locales.map((l) => (
          <a
            href={alt[l]}
            hreflang={htmlLang[l]}
            lang={htmlLang[l]}
            aria-current={l === lang ? 'true' : undefined}
            title={langName[l]}
            data-lang={l}
          ><span class="visually-hidden">{langName[l]}</span><span aria-hidden="true">{langLabel[l]}</span></a>
        ))}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <p>{t('authorized')} <span>{t('method')}</span></p>
      <p translate="no">{profile.name} ({profile.handle}), {tr(profile.base, lang)}</p>
    </footer>

    <script>
      import { backdrop } from '../scripts/backdrop';
      const c = document.getElementById('backdrop') as HTMLCanvasElement;
      try { if (backdrop(c)) c.classList.add('on'); } catch { /* the CSS gradient stays */ }
      if (document.querySelector('main img')) import('../scripts/lightbox').then((m) => m.lightbox());
    </script>

    <style>
      #backdrop { position: fixed; inset: 0; z-index: -1; width: 100%; height: 100%; opacity: 0; transition: opacity 1200ms var(--ease); pointer-events: none; }
      #backdrop:global(.on) { opacity: 1; }
      @media (prefers-reduced-motion: reduce) { #backdrop { transition: none; } }
      .tb {
        position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: clamp(12px, 3vw, 36px);
        height: var(--bar); padding: 0 var(--pad);
        background: color-mix(in srgb, var(--gutter) 93%, transparent);
        border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
      }
      .brand {
        display: inline-flex; align-items: center; gap: 0; flex: none; color: var(--fg-hi); text-decoration: none;
        font: 700 1.05rem/1 var(--mono);
      }
      .brand .at { color: var(--acc); font-weight: 500; }
      .sec { display: flex; gap: clamp(14px, 2.4vw, 30px); margin-left: auto; font-size: 0.86rem; font-weight: 500; text-transform: lowercase; }
      .sec a { color: var(--dim); text-decoration: none; padding: 8px 0; transition: color 180ms var(--ease); }
      .sec a::before { content: './'; color: var(--addr); }
      .sec a:hover, .sec a[aria-current='page'] { color: var(--acc); }

      .lang { display: flex; flex: none; border: 1px solid var(--line); border-radius: 2px; overflow: hidden; }
      .lang a {
        display: inline-flex; align-items: center; justify-content: center; min-width: 40px; min-height: 30px; padding: 0 10px;
        font: 600 0.74rem/1 var(--disp); letter-spacing: 0.04em; color: var(--dim); text-decoration: none;
        transition: background-color 180ms var(--ease), color 180ms var(--ease);
      }
      .lang a:hover { background: var(--panel-2); color: var(--fg-hi); }
      .lang a[aria-current='true'] { background: var(--acc); color: var(--gutter); }
      .lang a:focus-visible { outline-offset: -3px; }

      .foot {
        display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 32px; padding: 26px var(--pad) 34px;
        border-top: 1px solid var(--line); font-size: 0.8rem; color: var(--dim);
      }
      .foot span { color: var(--addr); margin-left: 6px; }

      @media (max-width: 720px) {
        .sec .opt { display: none; }
      }
    </style>
  </body>
</html>
