---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Redirect from '../../../components/Redirect.astro';
import { abs, authorRef, breadcrumbSchema, graph as ld, ogImage } from '../../../data/seo';
import { profile } from '../../../data/profile';
import { htmlLang, locales, localize, slugOf, urlPrefix, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups', (w) => !w.data.draft);
  // each writeup lives under the locale it is written in
  const ids = new Set(writeups.map((w) => w.id));
  const current = writeups.map((w) => ({
    params: { loc: urlPrefix[w.data.lang as Lang], slug: slugOf(w.id) },
    props: { w, paired: !!w.data.pair && ids.has(w.data.pair), redirect: undefined as string | undefined },
  }));
  // An earlier URL scheme used the content id, with its "-en" suffix, as the slug: /en-us/writeups/htb-redeye-en/.
  // Google still lists those addresses (they carry most of the search clicks), so they forward to the current slug
  // instead of answering 404.
  const legacy = writeups
    .filter((w) => slugOf(w.id) !== w.id)
    .map((w) => ({
      params: { loc: urlPrefix[w.data.lang as Lang], slug: w.id },
      props: { w, paired: false, redirect: localize(`/writeups/${slugOf(w.id)}/`, w.data.lang as Lang) as string | undefined },
    }));
  return [...current, ...legacy];
}
const { w, paired, redirect } = Astro.props;
const rendered = redirect ? undefined : await render(w);
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const toc = headings.filter((h) => h.depth === 2);
const lang = w.data.lang as Lang;
const L = (en: string, pt: string) => (lang === 'en' ? en : pt);
const self = localize(`/writeups/${slugOf(w.id)}/`, lang);
const otherLang: Lang = lang === 'en' ? 'pt-br' : 'en';
// Paired translations link to each other; without a pair the switch goes to that language's index.
const other = localize(paired ? `/writeups/${slugOf(w.data.pair!)}/` : '/writeups/', otherLang);
const alternates = { [lang]: self, [otherLang]: other } as Record<Lang, string>;
const schema = ld(
  {
    '@type': 'BlogPosting',
    '@id': `${abs(self)}#article`,
    mainEntityOfPage: abs(self),
    url: abs(self),
    headline: w.data.title,
    description: w.data.description ?? w.data.summary,
    datePublished: w.data.date.toISOString(),
    dateModified: w.data.date.toISOString(),
    inLanguage: htmlLang[lang],
    image: abs(ogImage.src),
    keywords: w.data.tags.join(', '),
    author: authorRef,
    publisher: authorRef,
  },
  breadcrumbSchema([[L('Home', 'Início'), localize('/', lang)], ['Writeups', localize('/writeups/', lang)], [w.data.title, self]]),
);
---
{redirect ? <Redirect to={redirect} /> : (
<Base
  title={w.data.seoTitle ?? w.data.title}
  description={w.data.description ?? w.data.summary}
  lang={lang}
  alternates={alternates}
  translations={paired ? locales : []}
  article={{ published: w.data.date, tags: w.data.tags }}
  schema={schema}
  quiet
>
  <article class="pane">
    <header>
      <p class="meta" translate="no"><time datetime={fmt(w.data.date)}>{fmt(w.data.date)}</time>, {L('by', 'por')} <a href={localize('/', lang)} rel="author">{profile.name} ({profile.handle})</a>{w.data.target && <>, {L('target', 'alvo')}: {w.data.target}</>}</p>
      <h1>{w.data.title}</h1>
      <p class="lede">{w.data.summary}</p>
      {(w.data.cve || w.data.severity || w.data.tags.length > 0) && (
        <dl class="facts" translate="no">
          {w.data.cve && <div><dt>cve</dt><dd>{w.data.cve}</dd></div>}
          {w.data.severity && <div><dt>{L('severity', 'severidade')}</dt><dd>{w.data.severity}</dd></div>}
          {w.data.tags.length > 0 && <div><dt>tags</dt><dd>{w.data.tags.join(' · ')}</dd></div>}
        </dl>
      )}
    </header>

    {toc.length > 2 && (
      <nav class="toc" aria-label={L('On this page', 'Nesta página')}>
        <p class="toc-h">{L('On this page', 'Nesta página')}</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="end">
      <a href={localize('/writeups/', lang)}>{L('All writeups', 'Todos os writeups')}</a>
    </footer>
  </article>
</Base>
)}

<style>
  .pane { padding: clamp(48px, 9vh, 88px) var(--pad) 80px; max-width: calc(72ch + 2 * var(--pad) + 120px); margin-inline: auto; }
  h1 { font: 700 clamp(1.9rem, 3.8vw, 3rem)/1.08 var(--mono); color: var(--fg-hi); letter-spacing: -0.05em; margin: 14px 0 18px; text-wrap: balance; }
  .meta { font: 500 0.8rem/1.4 var(--mono); color: var(--t-writeup); }
  .meta a { color: inherit; }
  .toc-h { font-weight: 700; color: var(--fg-hi); margin-bottom: 6px; }
  .lede { font: 400 1.05rem/1.6 var(--mono); color: var(--dim); max-width: 60ch; }
  .facts { display: flex; flex-wrap: wrap; gap: 6px 28px; margin-top: 24px; font: 500 13px/1.6 var(--mono); padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts div { display: flex; gap: 8px; }
  .facts dt { color: var(--addr); }
  .facts dd { color: var(--kw); }
  .toc { margin-top: 32px; font-size: 0.95rem; }
  .toc ol { padding-left: 2.2em; color: var(--addr); }

  .prose { margin-top: 40px; font: 400 1rem/1.8 var(--mono); color: var(--fg); max-width: 70ch; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { font: 700 1.5rem/1.2 var(--mono); color: var(--fg-hi); letter-spacing: -0.02em; margin-top: 2.2em; }
  .prose :global(h3) { font: 700 1.15rem/1.3 var(--mono); color: var(--fg-hi); margin-top: 1.8em; }
  .prose :global(strong) { color: var(--fg-hi); }
  .prose :global(:not(pre) > code) { font: 500 0.88em var(--mono); color: var(--kw); background: var(--panel); padding: 0.12em 0.36em; border-radius: 3px; }
  .prose :global(pre) {
    font: 400 14px/1.65 var(--mono); padding: 18px 20px; border-radius: 3px; overflow-x: auto;
    border: 1px solid var(--line); margin-left: -20px; margin-right: -20px;
  }
  .prose :global(blockquote) { border-left: 2px solid var(--kw); padding-left: 18px; color: var(--dim); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 3px; border: 1px solid var(--line); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font: 400 14px/1.5 var(--mono); }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.5em 0; }
  .end { margin-top: 64px; display: grid; gap: 6px; }

  @media (max-width: 900px) { .prose :global(pre) { margin-left: 0; margin-right: 0; } }
</style>
