---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const writeups = (await getCollection('writeups', (w) => !w.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base
  title="Writeups — Marcos Tolosa (Tr0p)"
  description="Technical writeups on vulnerability research, exploit development and reverse engineering by Marcos Tolosa (Tr0p)."
  current="writeups"
>
  <header class="head">
    <p class="c">; sub_401520 writeups() · {writeups.length} entries</p>
    <h1>Writeups</h1>
    <p class="lede">Root cause first, then the exploit, then how to find the next one. Step by step, nothing skipped.</p>
  </header>

  {writeups.length > 0 ? (
    <ol class="list">
      {writeups.map((w) => (
        <li>
          <a href={`/writeups/${w.id}/`}>
            <span class="meta a">{fmt(w.data.date)}{w.data.cve && <> · {w.data.cve}</>}{w.data.severity && <> · {w.data.severity}</>}</span>
            <span class="t">{w.data.title}</span>
            <span class="sum">{w.data.summary}</span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <div class="empty">
      <p><span class="c">; nothing published here yet.</span></p>
      <p>Until the first writeup lands, the coordinated advisories are the primary sources: start at <a href="/#disclosures">disclosures()</a>.</p>
    </div>
  )}
</Base>

<style>
  .head { padding: clamp(48px, 9vh, 96px) var(--pad) 40px; border-bottom: 1px solid var(--line); }
  h1 { font: 900 clamp(2.6rem, 6vw, 4.6rem)/1 var(--disp); color: var(--fg-hi); letter-spacing: -0.035em; margin: 16px 0 16px; }
  .lede { font: 500 1.2rem/1.5 var(--disp); max-width: 46ch; }
  .list { list-style: none; padding: 0; }
  .list a {
    display: grid; gap: 6px; padding: 26px var(--pad); border-bottom: 1px solid var(--line);
    text-decoration: none; color: var(--fg); transition: background-color 180ms var(--ease);
  }
  .list a:hover { background: var(--hl); }
  .meta { font-size: 12.5px; }
  .t { font: 800 1.5rem/1.2 var(--disp); color: var(--fg-hi); letter-spacing: -0.015em; }
  .sum { font: 400 1.05rem/1.55 var(--disp); color: var(--dim); max-width: 68ch; }
  .empty { padding: 40px var(--pad); color: var(--dim); display: grid; gap: 8px; max-width: 80ch; }
</style>
